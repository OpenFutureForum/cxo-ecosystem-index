{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CXO Ecosystem canonical entity schema 3.0.0",
  "type":"object",
  "required":["id","name","slug","entity_type","description","website","cxo_roles","categories","geographies","inclusion_basis","sources","date_added","last_verified","verification_status"],
  "properties":{
    "id":{"type":"string","pattern":"^ent_[a-z0-9_]+$"},
    "name":{"type":"string","minLength":2},"legal_name":{"type":["string","null"]},"entity_status":{"enum":["active","acquired","merged","inactive","rebranded","subsidiary","division","historical"]},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "website":{"type":"string","format":"uri"},"linkedin":{"type":["string","null"],"format":"uri"},"founded_year":{"type":["integer","null"],"minimum":1000},"founders":{"$ref":"#/$defs/ids"},"headquarters":{"type":["object","null"]},"locations":{"type":"array"},"operating_geographies":{"$ref":"#/$defs/ids"},
    "cxo_roles":{"$ref":"#/$defs/ids"},"categories":{"$ref":"#/$defs/required_ids"},"provider_types":{"$ref":"#/$defs/ids"},
    "community_formats":{"$ref":"#/$defs/ids"},"event_formats":{"$ref":"#/$defs/ids"},"intelligence_types":{"$ref":"#/$defs/ids"},"resource_types":{"$ref":"#/$defs/ids"},"executive_needs":{"$ref":"#/$defs/ids"},"topics":{"$ref":"#/$defs/ids"},"audiences":{"$ref":"#/$defs/ids"},
    "aliases":{"$ref":"#/$defs/ids"},"subcategories":{"$ref":"#/$defs/ids"},"capabilities":{"$ref":"#/$defs/ids"},"products":{"$ref":"#/$defs/ids"},"services":{"$ref":"#/$defs/ids"},"customer_segments":{"$ref":"#/$defs/ids"},"company_size_focus":{"$ref":"#/$defs/ids"},"ownership":{"type":["string","null"]},"parent_company":{"type":["string","null"]},"subsidiaries":{"$ref":"#/$defs/ids"},"investment_stage":{"$ref":"#/$defs/ids"},"application_required":{"type":["boolean","null"]},"invite_only":{"type":["boolean","null"]},"research_published":{"type":["boolean","null"]},"relationship_notes":{"type":["string","null"]},"editorial_priority":{"type":["string","null"],"enum":["A","B","C",null]},"facts":{"type":"array","items":{"$ref":"#/$defs/fact"}},
    "geographies":{"$ref":"#/$defs/required_ids"},"inclusion_basis":{"type":"array","minItems":1,"items":{"type":"string"}},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},"classification_evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
  },
  "$defs":{
    "ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"required_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "source":{"type":"object","required":["id","url","title","publisher","source_class","accessed_date","supports"],"properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"supports":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "evidence":{"type":"object","required":["url","title","supports"],"properties":{"url":{"type":"string","format":"uri"},"supports":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "fact":{"type":"object","required":["id","field","source_ids","last_verified"],"anyOf":[{"required":["value"]},{"required":["minimum"]},{"required":["maximum"]}],"properties":{"id":{"type":"string"},"field":{"type":"string"},"value":{},"minimum":{"type":"number"},"maximum":{"type":"number"},"currency":{"enum":["USD","EUR","GBP","CAD","CHF","JPY","AUD","SGD"]},"operator":{"enum":[">=","<=",">","<","="]},"qualifier":{"type":"string"},"verification_status":{"enum":["verified","high confidence","medium confidence","conflicting"]},"source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"last_verified":{"type":"string","format":"date"},"as_of_date":{"type":"string","format":"date"},"valid_from":{"type":"string","format":"date"},"valid_to":{"type":"string","format":"date"}}}
  }
}
